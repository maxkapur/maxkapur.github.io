{{/* Atom feed to replace the RSS 2.0 feed generated by Hugo by default. Note
  the content type definitions added in the theme's hugo.toml, too.

  By default, even when using this theme, you will only get RSS feeds; to enable
  Atom as an output format, you have to specify so in your *site*'s hugo.toml.

  Reference: https://github.com/gohugoio/hugo/blob/master/tpl/tplimpl/embedded/templates/rss.xml
*/}}

{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end }}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
  {{- $pages = $pctx.RegularPages.ByDate.Reverse }}
{{- else }}
  {{- $pages = $pctx.Pages.ByDate.Reverse }}
{{- end }}

{{- $dateFormat := "2006-01-02T15:04:05-07:00" }}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title type="text">
    {{- if or .IsHome (not .Title) -}}
      {{- .Site.Title -}}
    {{- else }}
      {{ printf "%s | %s" .Title .Site.Title -}}
    {{- end -}}
  </title>

  {{- with .OutputFormats.Get "atom" }}
    <link href="{{ .Permalink }}" rel="self" />
  {{- end }}
  <link href="{{ .Site.BaseURL }}" rel="alternate" />

  {{- with or .Site.Params.subtitle .Site.Params.description }}
    <subtitle type="text">{{ . }}</subtitle>
  {{- end }}

  {{- with (collections.Index $pages.ByLastmod.Reverse 0) }}
    <updated>{{ time.Format $dateFormat .Lastmod }}</updated>
  {{- end }}

  {{- with .Site.BaseURL }}
    <id>{{ . }}</id>
  {{- end }}

  {{- if or .Site.Params.author.name  .Site.Params.author.email }}
    <author>
      {{- with .Site.Params.author.name }}
        <name>{{ . }}</name>
      {{- end }}
      {{- with .Site.Params.author.email }}
        <email>{{ . }}</email>
      {{- end }}
    </author>
  {{- end }}


  <rights type="text">Creative Commons CC BY-SA 4.0 license</rights>

  {{- range $pages }}
    <entry>
      <title type="text">{{ .Title }}</title>
      <link rel="alternate" href="{{ .Permalink }}" />
      <updated>{{ .Lastmod.Format $dateFormat | safeHTML }}</updated>
      <published>{{ .PublishDate.Format $dateFormat | safeHTML }}</published>
      <id>{{ or .Params.id .Permalink }}</id>

      {{- /* An RFC 4287 Simple Extension element: human-readable representation
        of the publication date. We use this in the stylesheet to show a concise
        date instead of the dense ISO format string.
      */}}
      <readableDate>{{ .PublishDate.Format "Jan 2, 2006" }}</readableDate>

      <summary type="html">
        {{ .Summary | transform.XMLEscape | safeHTML }}
      </summary>

      <content type="html">
        {{ .Content | transform.XMLEscape | safeHTML }}
      </content>
    </entry>
  {{- end }}

</feed>
